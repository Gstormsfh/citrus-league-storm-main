-- The box score the user clicks into: the v2 line rollup, the same relation
-- persist_matchup_lines writes into fantasy_matchup_lines. This is the number
-- the scoreboard is supposed to agree with.
create view public.proof_box_score as
  select m.id as matchup_id, t.team_id, t.side,
         coalesce((select round(sum(sl.points),3)
                     from public.score_matchup_lines(m.id, t.team_id, m.week_start_date, m.week_end_date) sl), 0) as box_total
    from public.matchups m
    cross join lateral (values (m.team1_id,'team1'),(m.team2_id,'team2')) t(team_id, side)
   where t.team_id is not null;

create table public.proof_old_scores (
  matchup_id uuid primary key, team1_score numeric, team2_score numeric);

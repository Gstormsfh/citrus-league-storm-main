  select box_total into box_a2 from public.proof_box_score
   where matchup_id = 'a0000000-0000-4000-8000-0000000000f1' and side = 'team2';

  -- Twelve-category arithmetic, by hand:
  --   A1 = 10.2 (8478402) + 6.9 (8477934) + 8.0 (8471679) = 25.100
  --   A2 = 10.0 (8480069) + 9.8 (8476945) + 2.2 (8474596) = 22.000
  if a1 <> 25.100 or a2 <> 22.000 then
    raise exception 'UNEXPECTED: old writer gave % - %, expected 25.100 - 22.000; the capture may not be the live body', a1, a2;
  end if;
  -- The control league must score the same, since the fixtures are identical
  -- apart from plus_minus, which the old writer cannot see in either league.
  if b1 <> 25.100 or b2 <> 22.000 then
    raise exception 'UNEXPECTED: control league gave % - %', b1, b2;
  end if;


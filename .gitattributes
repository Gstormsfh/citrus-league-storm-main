# Normalize all text files to LF in the repo, auto-convert on checkout
* text=auto eol=lf

# Explicitly mark binary files so Git never tries to diff/merge them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
*.pdf binary

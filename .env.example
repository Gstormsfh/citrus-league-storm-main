# ============================================================================
# Citrus Sports - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------------------------
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key - ONLY for server-side Python scripts
# NEVER use this in client-side code (React/TypeScript)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----------------------------------------------------------------------------
# Proxy Configuration (for data scraping)
# ----------------------------------------------------------------------------
# Webshare proxy service credentials
# Get these from your Webshare dashboard
CITRUS_PROXY_USERNAME=your_webshare_username
CITRUS_PROXY_PASSWORD=your_webshare_password
CITRUS_PROXY_API_URL=your_webshare_api_url

# Enable/disable proxy rotation (true/false)
CITRUS_PROXY_ENABLED=true

# ----------------------------------------------------------------------------
# Firebase Configuration (Analytics)
# ----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ----------------------------------------------------------------------------
# Google AdSense (Monetization)
# ----------------------------------------------------------------------------
# Get your publisher ID from https://adsense.google.com after approval
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_PUBLISHER_ID=
# Set to false to disable ads even with a publisher ID configured
VITE_ADSENSE_ENABLED=true

# ----------------------------------------------------------------------------
# Sentry Error Monitoring
# ----------------------------------------------------------------------------
# Get your DSN from https://sentry.io > Project Settings > Client Keys
# Leave blank to disable error monitoring (e.g., in development)
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# Optional: Test Mode Configuration
# ----------------------------------------------------------------------------
# Enable test mode for development/testing
VITE_TEST_MODE=false
VITE_TEST_DATE=2025-12-08

# ----------------------------------------------------------------------------
# Security Notes
# ----------------------------------------------------------------------------
# - All credentials should be kept secret
# - Rotate credentials periodically
# - Never commit .env to git (already in .gitignore)
# - Use different credentials for development vs production
# - If credentials are exposed, rotate them immediately
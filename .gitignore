# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.code-workspace
.idea
.idea/
*.iml
*.ipr
*.iws
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.atom/
.buildlog/
.history
.svn/

# Miscellaneous
*.class
*.pyc
__pycache__/

# Large training data files (too big for Git, train locally)
data/*.csv.gz
data/moneypuck_shots_2018*.csv
data/moneypuck_shots_historical*.csv
data/shots_2018-2024.csv
data/shots_2018-2024.zip

# Temporary files
temp_*.json
test-*.html
fix_*.sql

# Phase 0c pre/post-load golden baselines (contain prod fingerprints;
# treat as ephemeral run artifacts, not committed provenance)
scripts/utilities/_golden_preload.json
scripts/utilities/_golden_postload.json

# Ignore stray PowerShell scratch scripts, but allow our ops scripts
*.ps1
!ops/windows/*.ps1
git-*.txt
git-*.log
git-diagnostic-output/

# Environment variables - NEVER commit .env files with secrets!
.env
.env.local
.env.*.local
.env.staging
.env.production
.env.prod
apps/web/.env.staging
apps/web/.env.production
apps/web/.env.prod

# Firebase
.firebase/

# Flutter (not part of this project)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# TypeScript incremental build cache — regenerated by every tsc run, never commit
**/*.tsbuildinfo

# Supabase CLI cache — version marker + local state, regenerated on every CLI run
supabase/.temp/

# Python test/caches (a pytest run at the repo root leaves these; the new
# CI pytest job makes that a routine occurrence)
.pytest_cache/
**/.pytest_cache/
pytest-cache-files-*/
pytest-cache-files-*
__pycache__/
**/__pycache__/
*.pyc
_to_delete/
.claude/settings.local.json

# Miscellaneous
*.class
*.pyc
__pycache__/

# Training/analysis data files (regenerable — see data/TRAINING_DATA_MANIFEST.md)
data/*.csv
data/*.CSV
data/*.csv.gz
data/*.zip
!data/MoneyPuck_Shot_Data_Dictionary.CSV

# Temporary files
temp_*.json
test-*.html
fix_*.sql

# Ignore stray PowerShell scratch scripts, but allow our ops scripts
*.ps1
!ops/windows/*.ps1
git-*.txt
git-*.log
git-diagnostic-output/

# Environment variables - NEVER commit .env files with secrets!
.env
.env.local
.env.*.local
.env.staging
.env.production
apps/web/.env.staging
apps/web/.env.production

# Firebase
.firebase/

# Flutter (not part of this project)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# TypeScript incremental build cache — regenerated by every tsc run, never commit
**/*.tsbuildinfo

# Beads / Dolt files (added by bd init)
.beads/
.envrc
.dolt/
*.db
.beads-credential-key

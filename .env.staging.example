# Staging environment variables (Vite) — TEMPLATE
#
# LOCATION: this file lives at the MONOREPO ROOT (NOT apps/web/).
# apps/web/vite.config.ts has `envDir: '../../'` which tells Vite to look
# for .env files at the repo root. Keep this template (and its copy,
# `.env.staging`) here.
#
# Copy this file to `.env.staging` (same directory as this template) and
# fill in the secret values. `.env.staging` is gitignored so secrets
# never leak.
#
# Usage (from repo root):
#   1. cp .env.staging.example .env.staging
#   2. Fill in the JWT value from the staging Supabase dashboard
#   3. Deploy: npm run deploy:staging --workspace=apps/web
#
# These values end up embedded in the built JS bundle — they are NOT secret
# by design (Supabase anon key and Firebase apiKey are meant to be public,
# scoped by RLS + Firebase Rules). But we keep them out of git anyway to
# avoid accidentally committing a rotated value and to keep one canonical
# source of truth in each deployment's secret store.

# ── Supabase (staging) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://jjgspcpvqaiitloglxbb.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY_FROM_SUPABASE_DASHBOARD

# ── Firebase (staging) ────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyBqG1dKoUYoQlv89Ph-pLIHxspbNUoJuQQ
VITE_FIREBASE_APP_ID=1:85541179096:web:e76ff9a8f5e70b384a11ad

# Google Analytics — disabled on staging (we skipped enabling it when the
# Firebase project was created). Leave blank.
VITE_FIREBASE_MEASUREMENT_ID=

# ── API URL ──────────────────────────────────────────────────────────
# Leave blank — Firebase Hosting rewrites /api/** to Cloud Run within
# the same project (citrus-fantasy-staging).
VITE_API_URL=

# ── Observability ────────────────────────────────────────────────────
# Sentry staging project not yet created. Leave blank — the app handles
# missing Sentry DSN gracefully (errors log to console only).
VITE_SENTRY_DSN=

# ── Feature flags for staging ────────────────────────────────────────
# Keep ads off on staging so test traffic doesn't affect ad metrics.
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_ENABLED=false

# Non-test mode — use real projections + real player data.
VITE_TEST_MODE=false

      {
        "xPos": 4,
        "yPos": 10,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "watchdog_ok per 5 min (expect 5; alert: absent 15 min)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "yAxis": {
              "label": "count / 5 min",
              "scale": "LINEAR"
            },
            "thresholds": [
              {
                "label": "absent",
                "value": 1,
                "color": "RED",
                "direction": "BELOW",
                "targetAxis": "Y1"
              }
            ],
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "legendTemplate": "watchdog_ok ${metric.labels.environment}",
                "minAlignmentPeriod": "300s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type = \"logging.googleapis.com/user/citrus_engine_watchdog_ok\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.environment"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }

      {
        "xPos": 3,
        "yPos": 14,
        "width": 9,
        "height": 5,
        "widget": {
          "title": "Deploy fingerprints, watchdog failures and VM startup failures (raw lines)",
          "logsPanel": {
            "filter": "(logName=\"projects/${PROJECT_ID}/logs/citrus-startup-failed\") OR ((jsonPayload.container.metadata.app=\"citrus-draft-engine\" OR labels.app=\"citrus-draft-engine\") AND (jsonPayload.event=\"deployment.fingerprint\" OR jsonPayload.event=\"event_subscription.watchdog_failed\" OR jsonPayload.message:\"\\\"event\\\":\\\"deployment.fingerprint\\\"\" OR jsonPayload.message:\"\\\"event\\\":\\\"event_subscription.watchdog_failed\\\"\"))"
          }
        }

{
  "displayName": "Citrus Draft Mandate",
  "labels": {
    "app": "citrus-draft-engine",
    "managed-by": "apply-monitoring-sh"
  },
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "How to read this board",
          "text": {
            "format": "MARKDOWN",
            "content": "Targets are CLAUDE.md 'Hard performance targets': manual pick p95 <= 300 ms / p99 <= 500 ms, autopick p95 <= 1000 ms / p99 <= 2000 ms, pick-to-broadcast fanout p95 <= 200 ms. Series are log-based DISTRIBUTION metrics over the engine's structured lines (`pick.processed {totalMs, rpcMs, broadcastMs}` = engine-authored picks, i.e. autopicks today; `external_event.applied.notifyToBroadcastMs` = events written by another process, i.e. every manual pick submitted over HTTP today). Server side only; end-to-end client numbers live in the 10c harness. RED lines are Mandate limits, YELLOW lines are guidance. Autopick deadline->commit latency from `draft_events` is the weekly `draft-scorecard` workflow, not this board. Runbook: docs/RUNBOOKS/draft-engine-v2-operations.md sections 2.4 / 2.5 / 3.5. Managed by infra/gcp/monitoring/apply-monitoring.sh - edit the JSON, not the console."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Autopick totalMs (pick.processed, wasAutopick=true) - p50 / p95 / p99 [Mandate p95 <= 1000, p99 <= 2000]",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "thresholds": [
              {
                "label": "Mandate autopick p95 (1000 ms)",
                "value": 1000,
                "color": "RED",
                "direction": "ABOVE",
                "targetAxis": "Y1"
              },
              {
                "label": "Mandate autopick p99 (2000 ms)",
                "value": 2000,
                "color": "YELLOW",
                "direction": "ABOVE",
                "targetAxis": "Y1"
              }
            ],
            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "p50",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type = \"logging.googleapis.com/user/citrus_engine_pick_total_ms\" AND metric.label.wasAutopick = \"true\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "legendTemplate": "p95",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type = \"logging.googleapis.com/user/citrus_engine_pick_total_ms\" AND metric.label.wasAutopick = \"true\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "legendTemplate": "p99",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type = \"logging.googleapis.com/user/citrus_engine_pick_total_ms\" AND metric.label.wasAutopick = \"true\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "groupByFields": []
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {

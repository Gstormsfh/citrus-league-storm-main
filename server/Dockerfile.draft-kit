# Opt-in paid-download runtime. Readiness stays off until the private edition
# and every download format pass staging acceptance. The main image is unchanged.
FROM node:22.18.0-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
RUN npm ci --ignore-scripts

FROM node:22.18.0-bookworm-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
COPY scripts/draft-guide/requirements-delivery.txt /tmp/requirements-delivery.txt
RUN python3 -m venv /opt/pdf && /opt/pdf/bin/pip install --no-cache-dir -r /tmp/requirements-delivery.txt
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./
COPY server/ ./server/
COPY packages/shared/ ./packages/shared/
COPY scripts/draft-guide/ ./scripts/draft-guide/
ENV NODE_ENV=production PORT=8080
ENV DRAFT_KIT_PYTHON=/opt/pdf/bin/python3 CITRUS_TSX=/app/node_modules/.bin/tsx CITRUS_DRAFT_KIT_OFFLINE_ASSETS=true
EXPOSE 8080
CMD ["node_modules/.bin/tsx", "server/src/index.ts"]

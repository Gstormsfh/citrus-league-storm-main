{
  "name": "citrus-fantasy-sports",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=server",
    "dev:draft-engine": "npm run dev:draft-engine --workspace=server",
    "dev:all": "npm run dev --workspace=apps/web & npm run dev --workspace=server",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/web",
    "build:server": "npm run build --workspace=packages/shared && npm run build --workspace=server",
    "build:all": "npm run build --workspace=packages/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspace=apps/web",
    "test:server": "npm run test --workspace=server",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "npm run lint --workspace=apps/web",
    "deploy": "npm run build && npm run deploy --workspace=apps/web",
    "firebase": "cd apps/web && npx firebase",
    "validate-migration": "ts-node scripts/validate-migration.ts",
    "validate-all-migrations": "ts-node scripts/validate-migration.ts",
    "test-migrations": "ts-node scripts/test-migrations.ts",
    "db:push": "node scripts/db-push.mjs",
    "gen:scoring": "node scripts/gen-scoring-defaults.mjs",
    "gen:scoring:check": "node scripts/gen-scoring-defaults.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}

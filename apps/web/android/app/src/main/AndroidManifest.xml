<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback deep link — the Android leg of the same
                 flow iOS registers in Info.plist (CFBundleURLSchemes):
                 the system browser finishes Google/Apple sign-in and
                 citrussports://auth-callback?code=... re-enters the app,
                 where nativeAuth.ts exchanges the PKCE code.
                 launchMode="singleTask" (above) keeps the callback from
                 spawning a second activity instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="citrussports" />
            </intent-filter>

            <!-- ANDROID APP LINKS (2026-09-09, Play Store prep). The Android
                 leg of the iOS universal links in
                 public/.well-known/apple-app-site-association: the same
                 invite, league and draft paths open the app instead of the
                 browser once /.well-known/assetlinks.json on
                 citrusfantasysports.com carries this app's signing
                 certificate fingerprint (Play App Signing key, copied from
                 Play Console > Setup > App signing after the first upload).
                 autoVerify makes Android check that file at install.
                 /auth is exact (the invite redirect) so /auth/callback and
                 /reset-password stay on the citrussports:// scheme and the
                 browser, as on iOS. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="citrusfantasysports.com" />
                <data android:host="www.citrusfantasysports.com" />
                <data android:path="/auth" />
                <data android:path="/create-league" />
                <data android:path="/join" />
                <data android:pathPrefix="/join/" />
                <data android:path="/joined" />
                <data android:pathPrefix="/league/" />
                <data android:path="/draft-room" />
                <data android:path="/draft" />
                <data android:path="/draft-kit" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission for push notifications
         (@capacitor/push-notifications requests it at registration). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>

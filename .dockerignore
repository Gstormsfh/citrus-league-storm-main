apps/web/src/
apps/web/public/
apps/web/index.html

# Data pipeline (separate container later)
data-pipeline/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# Firebase
.firebase/
firebase-debug.log

